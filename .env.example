# Copie para .env e escolha PINs diferentes antes de iniciar.
HOST=127.0.0.1
PORT=8787
APP_PIN=troque-por-um-pin-forte
ADMIN_PIN=troque-por-outro-pin
DATA_DIR=./data

# hermes (real) ou demo (simulado, não usa IA)
HERMES_MODE=hermes
